generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum RelationshipType {
  PREREQUISITE
  RELATED
  ADVANCED_FORM
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("users")
}

model AssessmentType {
  id          String @id @default(uuid())

  code        String @unique

  name        String
  slug        String @unique

  description String?

  status      ContentStatus @default(DRAFT)

  sortOrder   Int @default(0)

  topics      Topic[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("assessment_types")
}

model Topic {
  id                String @id @default(uuid())

  assessmentTypeId  String

  code              String @unique

  name              String
  slug              String @unique

  description       String?

  status            ContentStatus @default(DRAFT)

  sortOrder         Int @default(0)

  assessmentType    AssessmentType @relation(fields: [assessmentTypeId],references: [id])

  concepts          Concept[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@index([assessmentTypeId])

  @@map("topics")
}

model Concept {
  id          String @id @default(uuid())

  topicId     String

  code        String @unique
  name        String
  slug        String @unique

  description String?

  status      ContentStatus @default(DRAFT)
  sortOrder   Int @default(0)

  topic       Topic @relation(fields: [topicId], references: [id])

  frameworks  Framework[]

  parentRelationships ConceptRelationship[] @relation("ParentConcept")
  childRelationships  ConceptRelationship[] @relation("ChildConcept")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([topicId])
  @@index([code])

  @@map("concepts")
}

model Framework {
  id          String @id @default(uuid())

  conceptId   String

  name        String
  description String?

  status      ContentStatus @default(DRAFT)
  sortOrder   Int @default(0)

  concept     Concept @relation(fields: [conceptId], references: [id])

  steps       FrameworkStep[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([conceptId])

  @@map("frameworks")
}

model FrameworkStep {
  id          String @id @default(uuid())

  frameworkId String

  stepNumber  Int
  title       String
  description String

  framework   Framework @relation(fields: [frameworkId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([frameworkId, stepNumber])

  @@map("framework_steps")
}

model ConceptRelationship {
  id               String @id @default(uuid())

  parentConceptId  String
  childConceptId   String

  relationshipType RelationshipType

  parentConcept    Concept @relation("ParentConcept", fields: [parentConceptId], references: [id])
  childConcept     Concept @relation("ChildConcept", fields: [childConceptId], references: [id])

  createdAt        DateTime @default(now())

  @@index([parentConceptId])
  @@index([childConceptId])

  @@map("concept_relationships")
}